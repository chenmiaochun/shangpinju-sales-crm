{
  "name": "shangpinju-sales-crm",
  "private": true,
  "version": "1.0.0",
  "description": "尚品居家具经营管理系统",
  "author": "尚品居原创家具",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --test server/server.test.mjs",
    "desktop:dev": "electron .",
    "desktop:dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "date-fns": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.shangpinju.salescrm",
    "productName": "尚品居经营系统",
    "asar": true,
    "electronDist": "vendor/electron-dist",
    "directories": {
      "output": "artifacts/desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "尚品居经营系统",
      "artifactName": "尚品居经营系统-安装版-${version}.${ext}"
    }
  }
}
